+package org.jellyfin.playback.media3.exoplayer.dovi
+
+import io.kotest.core.spec.style.FunSpec
+import io.kotest.matchers.shouldBe
+import java.nio.ByteBuffer
+
+// HDR10+ SEI removal
+class Hdr10PlusSeiTests : FunSpec({
+	val header = byteArrayOf(0x4e, 0x01) // prefix SEI, layer 0, tid 1
+	// mastering display colour volume (137), 24 bytes, with two zeros followed by 0x01 -> needs an emulation byte
+	val mdcvPayload = ByteArray(24) { i -> if (i == 5) 1 else 0 }
+	val mdcv = byteArrayOf(137.toByte(), 24) + mdcvPayload
+	val hdr10Plus = byteArrayOf(4, 8, 0xb5.toByte(), 0x00, 0x3c, 0x00, 0x01, 0x04, 0x01, 0x40)
+
+	fun escape(rbsp: ByteArray): ByteArray {
+		val out = java.io.ByteArrayOutputStream()
+		var zeros = 0
+		for (b in rbsp) {
+			val v = b.toInt() and 0xff
+			if (zeros >= 2 && v <= 3) { out.write(3); zeros = 0 }
+			out.write(v)
+			zeros = if (v == 0) zeros + 1 else 0
+		}
+		return out.toByteArray()
+	}
+
+	fun nal(vararg messages: ByteArray) = header + escape(messages.fold(ByteArray(0)) { a, m -> a + m } + byteArrayOf(0x80.toByte()))
+
+	test("drops only the HDR10+ message and keeps the static metadata") {
+		val removed = IntArray(1)
+		DvVideoRenderer.rewriteSei(nal(mdcv, hdr10Plus), removed).toList() shouldBe nal(mdcv).toList()
+		removed[0] shouldBe 1
+	}
+
+	test("drops the whole NAL when only HDR10+ was in it") {
+		val removed = IntArray(1)
+		DvVideoRenderer.rewriteSei(nal(hdr10Plus), removed) shouldBe null
+		removed[0] shouldBe 1
+	}
+
+	test("leaves a NAL without HDR10+ untouched") {
+		val removed = IntArray(1)
+		val n = nal(mdcv)
+		DvVideoRenderer.rewriteSei(n, removed).toList() shouldBe n.toList()
+		removed[0] shouldBe 0
+	}
+
+	test("rewrites a sample in place and keeps the other NAL units") {
+		val slice = byteArrayOf(0, 0, 0, 1, 0x02, 0x01, 0x55, 0x66)
+		val sample = byteArrayOf(0, 0, 0, 1) + nal(mdcv, hdr10Plus) + byteArrayOf(0, 0, 0, 1) + nal(hdr10Plus) + slice
+		val buffer = ByteBuffer.allocate(sample.size).put(sample).also { it.flip() }
+		DvVideoRenderer.stripHdr10PlusSei(buffer) shouldBe 2
+		val result = ByteArray(buffer.remaining()).also { buffer.get(it) }
+		result.toList() shouldBe (byteArrayOf(0, 0, 0, 1) + nal(mdcv) + slice).toList()
+	}
+})
