+	/** Rewrites prefix SEI NALs (type 39) in place without their HDR10+ messages; returns messages removed. */
+	static int stripHdr10PlusSei(ByteBuffer b) {
+		int start = b.position(), end = b.limit();
+		byte[] src = new byte[end - start];
+		b.duplicate().get(src);
+		java.util.ArrayList<int[]> nals = new java.util.ArrayList<>(); // {startCodeStart, payloadStart}
+		for (int i = 0; i + 3 <= src.length; ) {
+			if (src[i] == 0 && src[i + 1] == 0 && src[i + 2] == 1) {
+				nals.add(new int[] {(i > 0 && src[i - 1] == 0) ? i - 1 : i, i + 3});
+				i += 3;
+			} else {
+				i++;
+			}
+		}
+		int removedTotal = 0;
+		java.io.ByteArrayOutputStream out = new java.io.ByteArrayOutputStream(src.length);
+		for (int k = 0; k < nals.size(); k++) {
+			int sc = nals.get(k)[0], p = nals.get(k)[1];
+			int e = k + 1 < nals.size() ? nals.get(k + 1)[0] : src.length;
+			int type = p < e ? (src[p] >> 1) & 0x3f : -1;
+			if (type == 39 && e - p > 2) {
+				int[] removed = new int[1];
+				byte[] nal = rewriteSei(java.util.Arrays.copyOfRange(src, p, e), removed);
+				if (removed[0] > 0) {
+					removedTotal += removed[0];
+					if (nal != null) {
+						out.write(src, sc, p - sc);
+						out.write(nal, 0, nal.length);
+					}
+					continue;
+				}
+			}
+			out.write(src, sc, e - sc);
+		}
+		if (removedTotal == 0) return 0;
+		byte[] o = out.toByteArray();
+		b.limit(b.capacity());
+		b.position(start);
+		b.put(o);
+		b.limit(start + o.length);
+		b.position(start);
+		return removedTotal;
+	}
+
+	/** SEI NAL (header included) without HDR10+ messages; null if nothing is left. removed[0] = messages dropped. */
+	static byte[] rewriteSei(byte[] nal, int[] removed) {
+		java.io.ByteArrayOutputStream rbsp = new java.io.ByteArrayOutputStream(nal.length);
+		int zeros = 0;
+		for (int i = 2; i < nal.length; i++) { // drop emulation prevention bytes
+			int v = nal[i] & 0xff;
+			if (zeros >= 2 && v == 3) { zeros = 0; continue; }
+			zeros = v == 0 ? zeros + 1 : 0;
+			rbsp.write(v);
+		}
+		byte[] r = rbsp.toByteArray();
+		int n = r.length;
+		while (n > 0 && r[n - 1] == 0) n--; // trailing zero bytes
+		n--; // rbsp_stop_one_bit byte (0x80)
+		java.io.ByteArrayOutputStream kept = new java.io.ByteArrayOutputStream(n);
+		int pos = 0, keptCount = 0;
+		while (pos < n) {
+			int msgStart = pos, payloadType = 0, payloadSize = 0;
+			while (pos < n && (r[pos] & 0xff) == 0xff) { payloadType += 255; pos++; }
+			if (pos >= n) return nal;
+			payloadType += r[pos++] & 0xff;
+			while (pos < n && (r[pos] & 0xff) == 0xff) { payloadSize += 255; pos++; }
+			if (pos >= n) return nal;
+			payloadSize += r[pos++] & 0xff;
+			if (pos + payloadSize > n) return nal; // malformed: leave the NAL alone
+			boolean hdr10Plus = payloadType == 4 && payloadSize >= 6 && (r[pos] & 0xff) == 0xb5 && r[pos + 1] == 0x00
+					&& r[pos + 2] == 0x3c && r[pos + 3] == 0x00 && r[pos + 4] == 0x01 && r[pos + 5] == 0x04;
+			pos += payloadSize;
+			if (hdr10Plus) {
+				removed[0]++;
+			} else {
+				kept.write(r, msgStart, pos - msgStart);
+				keptCount++;
+			}
+		}
+		if (removed[0] == 0) return nal;
+		if (keptCount == 0) return null;
+		kept.write(0x80);
+		byte[] k = kept.toByteArray();
+		java.io.ByteArrayOutputStream o = new java.io.ByteArrayOutputStream(k.length + 8);
+		o.write(nal[0]);
+		o.write(nal[1]);
+		zeros = 0;
+		for (byte x : k) { // re-insert emulation prevention bytes
+			int v = x & 0xff;
+			if (zeros >= 2 && v <= 3) { o.write(3); zeros = 0; }
+			o.write(v);
+			zeros = v == 0 ? zeros + 1 : 0;
+		}
+		return o.toByteArray();
+	}
