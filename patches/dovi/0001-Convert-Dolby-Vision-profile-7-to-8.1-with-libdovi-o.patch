+            // Dolby Vision: profile 7 converted to 8.1 with libdovi (as Kodi does); stray RPU/EL stripped for plain HEVC.
+            @Override
+            protected void buildVideoRenderers(Context ctx, int extensionRendererMode, MediaCodecSelector mediaCodecSelector,
+                    boolean enableDecoderFallback, Handler eventHandler, VideoRendererEventListener eventListener,
+                    long allowedVideoJoiningTimeMs, ArrayList<Renderer> out) {
