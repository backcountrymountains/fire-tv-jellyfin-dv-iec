+package org.jellyfin.playback.media3.exoplayer.audio
+
+import android.content.Context
+import androidx.annotation.OptIn
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.exoplayer.DefaultRenderersFactory
+import androidx.media3.exoplayer.audio.AudioSink
+import androidx.media3.exoplayer.audio.AudioTrackAudioOutputProvider
+import androidx.media3.exoplayer.audio.DefaultAudioSink
+
+/**
+ * [DefaultRenderersFactory] whose audio sink plays DTS, DTS-HD and TrueHD through [IecAudioOutputProvider].
+ */
+@OptIn(UnstableApi::class)
+class IecRenderersFactory(context: Context) : DefaultRenderersFactory(context) {
+	override fun buildAudioSink(
+		context: Context,
+		enableFloatOutput: Boolean,
+		enableAudioOutputPlaybackParams: Boolean,
+	): AudioSink = DefaultAudioSink.Builder(context)
+		.setEnableFloatOutput(enableFloatOutput)
+		.setEnableAudioOutputPlaybackParameters(enableAudioOutputPlaybackParams)
+		.setAudioOutputProvider(IecAudioOutputProvider(AudioTrackAudioOutputProvider.Builder(context).build()))
+		.build()
+}
diff --git a/playback/media3/exoplayer/src/test/kotlin/audio/IecPackerTests.kt b/playback/media3/exoplayer/src/test/kotlin/audio/IecPackerTests.kt
new file mode 100644
index 000000000..fccb9e7e0
--- /dev/null
+++ b/playback/media3/exoplayer/src/test/kotlin/audio/IecPackerTests.kt
@@ -0,0 +1,87 @@
+package org.jellyfin.playback.media3.exoplayer.audio
+
+import io.kotest.core.spec.style.FunSpec
+import io.kotest.matchers.shouldBe
+import java.nio.ByteBuffer
+import java.security.MessageDigest
+
+/**
+ * Compares the packers with FFmpeg's spdif muxer. The fixtures are 0.2 s of a 440 Hz 5.1 sine created with FFmpeg:
+ *
+ * ```
+ * ffmpeg -f lavfi -i "sine=f=440:d=0.2" -af "pan=5.1|c0=c0|c1=c0|c2=c0|c3=c0|c4=c0|c5=c0" -c:a dca -strict -2 -b:a 768k -f dts dts-core.dts
+ * ffmpeg -f lavfi -i "sine=f=440:d=0.2" -af "pan=5.1|c0=c0|c1=c0|c2=c0|c3=c0|c4=c0|c5=c0" -c:a truehd -strict -2 -f truehd truehd.thd
+ * ```
+ *
+ * The expected hashes are of `ffmpeg -i dts-core.dts -c copy -f spdif -dtshd_rate 768000` and
+ * `ffmpeg -i truehd.thd -c copy -f spdif`.
+ */
+class IecPackerTests : FunSpec({
+	fun resource(name: String) = requireNotNull(IecPackerTests::class.java.getResourceAsStream("/iec/$name")).readBytes()
+
+	fun ByteArray.u16(offset: Int) = (this[offset].toInt() and 0xff shl 8) or (this[offset + 1].toInt() and 0xff)
+
+	fun packAll(packer: IecPacker, buffers: List<ByteBuffer>): ByteArray {
+		val bursts = mutableListOf<ByteBuffer>()
+		buffers.forEach { packer.pack(it, bursts) }
+		val output = ByteBuffer.allocate(bursts.sumOf { it.remaining() })
+		bursts.forEach { output.put(it) }
+		return output.array()
+	}
+
+	fun ByteArray.sha256() = MessageDigest.getInstance("SHA-256").digest(this).joinToString("") { "%02x".format(it) }
+
+	test("DTS is packed as type IV like FFmpeg") {
+		val stream = resource("dts-core.dts")
+		val frames = buildList {
+			var offset = 0
+			while (offset < stream.size) {
+				val frameSize = ((stream.u16(offset + 5) shl 8 or (stream[offset + 7].toInt() and 0xff)) shr 4 and 0x3fff) + 1
+				add(ByteBuffer.wrap(stream, offset, frameSize).slice())
+				offset += frameSize
+			}
+		}
+
+		val output = packAll(DtsHdIecPacker(), frames)
+
+		output.size shouldBe 622_592
+		output.sha256() shouldBe "d4a9ab67a13afb00b064974b65b7ab20c0bed50fc30b2be5b58ff7003ba2880c"
+	}
+
+	test("TrueHD is packed into MAT frames like FFmpeg") {
+		val stream = resource("truehd.thd")
+		val accessUnits = buildList {
+			var offset = 0
+			while (offset < stream.size) {
+				val size = (stream.u16(offset) and 0x0fff) * 2
+				add(offset to size)
+				offset += size
+			}
+		}
+		// Media3 delivers 16 access units per buffer
+		val buffers = accessUnits.chunked(16).map { chunk ->
+			val start = chunk.first().first
+			val end = chunk.last().let { it.first + it.second }
+			ByteBuffer.wrap(stream, start, end - start).slice()
+		}
+
+		val output = packAll(TrueHdIecPacker(), buffers)
+
+		output.size shouldBe 552_960
+		output.sha256() shouldBe "5bdae6584a54af0977818bd91011fa72c72488c3343c654201362850d5df0269"
+	}
+
+	test("Recycled bursts are reused") {
+		val stream = resource("dts-core.dts")
+		val frameSize = ((stream.u16(5) shl 8 or (stream[7].toInt() and 0xff)) shr 4 and 0x3fff) + 1
+		val packer = DtsHdIecPacker()
+		val bursts = mutableListOf<ByteBuffer>()
+
+		packer.pack(ByteBuffer.wrap(stream, 0, frameSize).slice(), bursts)
+		val first = bursts.removeFirst()
+		packer.recycle(first)
+		packer.pack(ByteBuffer.wrap(stream, 0, frameSize).slice(), bursts)
+
+		(bursts.single() === first) shouldBe true
+	}
+})
diff --git a/playback/media3/exoplayer/src/test/kotlin/audio/IecPositionSmootherTests.kt b/playback/media3/exoplayer/src/test/kotlin/audio/IecPositionSmootherTests.kt
