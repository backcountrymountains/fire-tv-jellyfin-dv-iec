index 000000000..14282b5ef
--- /dev/null
+++ b/playback/media3/exoplayer/src/test/kotlin/audio/IecPositionSmootherTests.kt
@@ -0,0 +1,49 @@
+package org.jellyfin.playback.media3.exoplayer.audio
+
+import io.kotest.core.spec.style.FunSpec
+import io.kotest.matchers.longs.shouldBeLessThanOrEqual
+import io.kotest.matchers.shouldBe
+
+class IecPositionSmootherTests : FunSpec({
+	val stepNanos = 10_000_000L
+	val stepUs = 10_000L
+
+	/** Feeds positions every 10 ms starting at [startUs], with [offsetUs] added to the track position from [jumpAt]. */
+	fun run(startUs: Long, steps: Int, jumpAt: Int, offsetUs: Long): List<Long> {
+		val smoother = IecPositionSmoother()
+		return (0 until steps).map { i ->
+			val raw = startUs + i * stepUs + if (i >= jumpAt) offsetUs else 0
+			smoother.smooth(raw, i * stepNanos)
+		}
+	}
+
+	test("Steady positions pass through unchanged") {
+		run(startUs = 5_000_000, steps = 100, jumpAt = Int.MAX_VALUE, offsetUs = 0) shouldBe
+			(0 until 100).map { 5_000_000 + it * stepUs }
+	}
+
+	test("A small timestamp jump is absorbed gradually") {
+		val positions = run(startUs = 5_000_000, steps = 300, jumpAt = 10, offsetUs = 44_000)
+
+		// Each 10 ms step moves at most 2 % + 0.2 ms faster than real time
+		positions.zipWithNext { a, b -> b - a }.forEach { it shouldBeLessThanOrEqual stepUs + stepUs / 50 + 200 }
+		// After 3 s the jump is fully followed
+		positions.last() shouldBe 5_000_000 + 299 * stepUs + 44_000
+	}
+
+	test("A large jump is followed immediately") {
+		val positions = run(startUs = 5_000_000, steps = 20, jumpAt = 10, offsetUs = 500_000)
+
+		positions[10] shouldBe 5_000_000 + 10 * stepUs + 500_000
+	}
+
+	test("The position never moves backwards") {
+		val positions = run(startUs = 5_000_000, steps = 50, jumpAt = 10, offsetUs = -40_000)
+
+		positions.zipWithNext { a, b -> b - a }.forEach { (it >= 0) shouldBe true }
+	}
+
+	test("The first second follows the track directly") {
+		run(startUs = 0, steps = 50, jumpAt = 10, offsetUs = 30_000)[10] shouldBe 10 * stepUs + 30_000
+	}
+})
